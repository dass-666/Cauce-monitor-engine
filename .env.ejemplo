# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a un repositorio.

# Contraseña del usuario administrador inicial (mín. 10 caracteres, letras y números).
MONITOREO_ADMIN_PASSWORD=
MONITOREO_ADMIN_USER=admin

# Clave para firmar webhooks. Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOREO_SECRET_KEY=

# Base de datos. Por defecto SQLite en data/monitoreo.db (no requiere instalar nada).
# PostgreSQL (recomendado en producción):
# MONITOREO_DB_URL=postgresql+psycopg://usuario:clave@localhost:5432/monitoreo

MONITOREO_HOST=127.0.0.1
MONITOREO_PUERTO=8000

# Hosts permitidos para webhooks y conectores HTTP (separados por coma).
MONITOREO_WEBHOOK_HOSTS=localhost,127.0.0.1

# 1 = sembrar datos ficticios de demostración la primera vez.
MONITOREO_DATOS_DEMO=1
MONITOREO_INICIAR_MOTOR=1
MONITOREO_TOKEN_TTL_HORAS=12

# --- v1.1 -------------------------------------------------------------------
# Telegram (opcional; ver docs/TELEGRAM.md). Sin estas variables el canal queda inactivo.
# MONITOREO_TELEGRAM_TOKEN=123456789:ABC...      token que entrega @BotFather (secreto)
# MONITOREO_TELEGRAM_CHATS=111111111,222222222    ids de chat AUTORIZADOS a recibir avisos
# Para probar sin Telegram real, apunta al emulador local incluido:
# MONITOREO_TELEGRAM_API=http://127.0.0.1:8000/api-prueba/telegram
# MONITOREO_TELEGRAM_TOKEN=000000:EMULADOR

# Duración del arrendamiento del planificador en segundos (coordinación entre instancias).
# Si una instancia se cae, otra toma el relevo tras este tiempo. Por defecto 15.
# MONITOREO_LEASE_S=15

# Migraciones en PostgreSQL: se hace respaldo con pg_dump antes de cambiar el esquema.
# Si pg_dump no está instalado la actualización se DETIENE. Para migrar sin respaldo (bajo tu
# responsabilidad):  MONITOREO_RESPALDO_PG=omitir

# --- v1.2 -------------------------------------------------------------------
# Entorno: desarrollo | pruebas | produccion  (ver docs/PRODUCCION.md).
# En produccion el servidor NO arranca si la configuración es insegura, no hay laboratorio
# ni rutas de prueba, nunca se crean datos de demostración y se registra en data/logs/.
MONITOREO_ENTORNO=desarrollo

# Límite de peticiones a la API del panel, por minuto e IP (0 = sin límite).
# Independiente del límite de consulta a cada fuente.
# MONITOREO_API_LIMITE_MIN=600
# MONITOREO_API_ESCRITURA_MIN=120

# Si el panel se publica detrás de un proxy inverso con HTTPS (Caddy, nginx), su IP:
# MONITOREO_PROXY_CONFIABLE=127.0.0.1

# --- v1.5: captura y reservaciones de LABORATORIO --------------------------------
# Portal de reservaciones de PRUEBA propio (iniciar_portal.bat). Solo 127.0.0.1, datos ficticios.
MONITOREO_PORTAL_URL=http://127.0.0.1:8200
# Token de PRUEBA de la API del portal (lo genera el instalador; si falta se usa uno local de laboratorio).
# MONITOREO_PORTAL_TOKEN=
# 1 = solo se aceptan expedientes con datos sintéticos (correo .test/.example, teléfono 555...).
MONITOREO_CAPTURA_SOLO_SINTETICOS=1
