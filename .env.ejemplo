# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a un repositorio.

# Contraseña del usuario administrador inicial (mín. 10 caracteres, letras y números).
MONITOREO_ADMIN_PASSWORD=
MONITOREO_ADMIN_USER=admin

# Clave para firmar webhooks. Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOREO_SECRET_KEY=

# Base de datos. Por defecto SQLite en data/monitoreo.db (no requiere instalar nada).
# PostgreSQL (recomendado en producción):
# MONITOREO_DB_URL=postgresql+psycopg://usuario:clave@localhost:5432/monitoreo

MONITOREO_HOST=127.0.0.1
MONITOREO_PUERTO=8000

# Hosts permitidos para webhooks y conectores HTTP (separados por coma).
MONITOREO_WEBHOOK_HOSTS=localhost,127.0.0.1

# 1 = sembrar datos ficticios de demostración la primera vez.
MONITOREO_DATOS_DEMO=1
MONITOREO_INICIAR_MOTOR=1
MONITOREO_TOKEN_TTL_HORAS=12
