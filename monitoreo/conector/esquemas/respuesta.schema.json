{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cauce.conector.v1/respuesta",
  "title": "Respuesta conector -> Monitor (stdout, un JSON). Sin valores personales. Contrato unificado cauce.conector.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contrato", "solicitud_id", "estado", "formulario", "campos", "confirmaciones", "errores", "revision_humana", "envio", "huella_preparacion", "duracion_ms"],
  "properties": {
    "contrato": {"const": "cauce.conector.v1"},
    "solicitud_id": {"type": "string", "pattern": "^sol_[0-9a-f]{16,32}$"},
    "estado": {"enum": ["preparado_revisado_sin_envio", "enviado_por_persona_observado", "preparado_con_incidencias",
                        "rechazado_no_autorizado", "detenido_intervencion_humana", "detenido_estructura_cambiada",
                        "rechazado_solicitud_invalida", "revision_caducada", "error_interno"]},
    "formulario": {
      "type": "object", "additionalProperties": false, "required": ["origen", "firma_estructura", "estructura_coincide", "cambios"],
      "properties": {
        "origen": {"type": "string", "pattern": "^https?://[A-Za-z0-9.-]{1,100}(:[0-9]{2,5})?(/[A-Za-z0-9._~/-]{0,100})?$"},
        "firma_estructura": {"type": "string", "pattern": "^(v2:[0-9a-f]{16})?$"},
        "estructura_coincide": {"type": "boolean"},
        "cambios": {
          "type": "object", "additionalProperties": false, "required": ["faltan", "nuevos", "modificados"],
          "properties": {
            "faltan": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[A-Za-z0-9_:.-]{1,60}$"}},
            "nuevos": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[A-Za-z0-9_:.-]{1,60}$"}},
            "modificados": {"type": "array", "maxItems": 64, "items": {
              "type": "object", "additionalProperties": false, "required": ["campo", "cambio"],
              "properties": {"campo": {"type": "string", "pattern": "^[A-Za-z0-9_:.-]{1,60}$"},
                             "cambio": {"enum": ["etiqueta", "tipo", "requerido", "patron", "longitud", "opciones", "autocompletar"]}}}}
          }
        }
      }
    },
    "campos": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["campo", "estado", "metodo", "caracteres"],
      "properties": {"campo": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
                     "estado": {"enum": ["ok", "ok_normalizado", "diferente", "invalido"]},
                     "metodo": {"enum": ["teclado_secuencial", "check", "seleccion", "fecha_nativa"]},
                     "caracteres": {"type": "integer", "minimum": 0, "maximum": 1000}}}},
    "confirmaciones": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["campo", "coinciden"],
      "properties": {"campo": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"}, "coinciden": {"type": "boolean"}}}},
    "errores": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["codigo"],
      "properties": {
        "codigo": {"enum": ["ESTRUCTURA_CAMBIADA", "NAVEGADOR_NO_DISPONIBLE", "PAGINA_NO_DISPONIBLE", "FORMULARIO_NO_AUTORIZADO",
                            "AUTORIZACION_CADUCADA", "SOLICITUD_REPETIDA", "SOLICITUD_CADUCADA", "PERFIL_NO_COINCIDE",
                            "CAMPO_NO_DECLARADO", "SOLICITUD_MAL_FORMADA", "INTERVENCION_HUMANA_REQUERIDA",
                            "REVISION_CADUCADA", "CAMPO_NO_VERIFICADO", "ERROR_INTERNO"]},
        "detalle": {"type": "string", "maxLength": 160}}}},
    "revision_humana": {
      "type": "object", "additionalProperties": false, "required": ["requerida", "resultado", "duracion_s"],
      "properties": {"requerida": {"type": "boolean"},
                     "resultado": {"enum": ["cerrada_sin_envio", "envio_humano", "caducada", "no_realizada"]},
                     "duracion_s": {"type": "integer", "minimum": 0, "maximum": 3600}}},
    "envio": {
      "type": "object", "additionalProperties": false, "required": ["realizado_por_conector", "envio_humano_observado"],
      "properties": {"realizado_por_conector": {"const": false}, "envio_humano_observado": {"type": "boolean"}}},
    "huella_preparacion": {"type": "string", "pattern": "^(sha256:[0-9a-f]{8,64})?$"},
    "duracion_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
  }
}
